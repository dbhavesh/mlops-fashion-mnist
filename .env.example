# ============================================================
# Fashion-MNIST MLOps application environment configuration
# ============================================================
#
# Copy this file to .env for local development when needed.
# Never commit the real .env file.
#
# Replace placeholder credential values with your own local
# development credentials.


# ------------------------------------------------------------
# MLflow
# ------------------------------------------------------------

# URL of the MLflow tracking server.
MLFLOW_TRACKING_URI=http://localhost:15000

# Name of the MLflow experiment used for training runs.
MLFLOW_EXPERIMENT_NAME=fashion-mnist-classifier


# ------------------------------------------------------------
# MinIO
# ------------------------------------------------------------

# MinIO server address.
MINIO_ENDPOINT=localhost:19000

# MinIO credentials.
# Replace these placeholder values in your local .env file.
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# false for local HTTP development; true when HTTPS is used.
MINIO_SECURE=false

# Required assignment bucket name.
# Preserve the exact spelling: "minst", not "mnist".
MINIO_BUCKET=fashion-minst-bucket


# ------------------------------------------------------------
# Training-complete webhook
# ------------------------------------------------------------

# Destination that receives the successful-training notification.
# Leave empty until a webhook receiver is configured.
WEBHOOK_URL=

# HTTP request timeout for webhook delivery, in seconds.
WEBHOOK_TIMEOUT_SECONDS=5


# ------------------------------------------------------------
# Model selection
# ------------------------------------------------------------

# Exact MinIO object key that FastAPI should serve.
# Example:
# MODEL_OBJECT_KEY=model/<mlflow-run-id>/model.pt
MODEL_OBJECT_KEY=


# ------------------------------------------------------------
# FastAPI
# ------------------------------------------------------------

# Address used by Streamlit when it is run directly on the host.
# Docker Compose overrides this with http://api:8000.
FASTAPI_BASE_URL=http://localhost:18000


# ------------------------------------------------------------
# Docker Compose host-port overrides
# ------------------------------------------------------------

# These are host-facing ports only. Containers communicate over
# Compose DNS using their internal service ports.
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MLFLOW_HOST_PORT=15000
API_HOST_PORT=18000
UI_HOST_PORT=18501
